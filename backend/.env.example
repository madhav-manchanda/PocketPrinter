# Copy to .env in this backend directory for local development.
APP_ENV=development
PROJECT_NAME="PocketPrint Backend"
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
DATABASE_URL=sqlite:///./pocketprint.db
STORAGE_ROOT=./storage
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000
TRUSTED_HOSTS=localhost,127.0.0.1
MAX_UPLOAD_SIZE=52428800
JOB_LEASE_SECONDS=120
DEVICE_ONLINE_TIMEOUT_SECONDS=90
LOG_LEVEL=INFO

# Optional: set BOTH values to bootstrap an administrator.
# ADMIN_BOOTSTRAP_EMAIL=admin@example.invalid
# ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-unique-strong-password
