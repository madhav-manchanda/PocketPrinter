# PocketPrint production environment template.
# Copy to a private .env file and replace every CHANGE_ME value.
APP_ENV=production
PROJECT_NAME="PocketPrint Cloud"

# Generate with: openssl rand -hex 32
POCKETPRINT_SECRET=CHANGE_ME_GENERATE_A_UNIQUE_RANDOM_SECRET

# Use a unique database password; URL-encode special characters.
DATABASE_URL=postgresql+psycopg://CHANGE_ME_USER:CHANGE_ME_PASSWORD@127.0.0.1:5432/pocketprint

# Explicit production allowlists; do not use wildcards.
CORS_ALLOWED_ORIGINS=https://CHANGE_ME_DASHBOARD_HOST
TRUSTED_HOSTS=CHANGE_ME_API_HOST

STORAGE_ROOT=/var/www/pocketprint/storage
MAX_UPLOAD_SIZE=52428800
JOB_LEASE_SECONDS=120
DEVICE_ONLINE_TIMEOUT_SECONDS=90

# Optional bootstrap account. Set both together only when needed.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

LOG_LEVEL=INFO
