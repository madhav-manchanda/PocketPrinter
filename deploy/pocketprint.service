[Unit]
Description=PocketPrint Cloud Backend Service
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=pocketprint
Group=pocketprint
WorkingDirectory=/var/www/pocketprint
EnvironmentFile=/etc/pocketprint/pocketprint.env
ExecStartPre=/usr/local/bin/python3 -m alembic -c backend/alembic.ini upgrade head
ExecStart=/usr/local/bin/uvicorn backend.app.main:app --host 127.0.0.1 --port 8000 --workers 2 --proxy-headers
Restart=always
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=30s

# Sandboxing and security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/pocketprint/storage /var/log/pocketprint

[Install]
WantedBy=multi-user.target
